{
  "name": "uiineed-todo-list",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "极简设计的网页版 Todo 清单，支持账号登录、图片附件与自托管部署",
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.2",
    "sass": "^1.83.4",
    "vite": "^6.0.11",
    "vue": "^3.5.13"
  }
}
